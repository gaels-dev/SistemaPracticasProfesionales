<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="vboxTarjeta" onMouseClicked="#handleSeleccionarEE" prefWidth="280.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #AAAAAA; -fx-border-radius: 10; -fx-cursor: hand;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.sistemapracticasprofesionales.controlador.FXMLTarjetaExperienciaEducativaController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label fx:id="lblNombreEE" text="[Nombre de la EE]" textFill="#333333" wrapText="true">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblSeccion" text="Sección: -" textFill="#555555">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label fx:id="lblPeriodo" text="Periodo: -" textFill="#555555">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
   </children>
</VBox>
