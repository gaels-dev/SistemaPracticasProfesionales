<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.sistemapracticasprofesionales.controlador.FXMLEvaluarActividadController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="90.0" spacing="15.0" style="-fx-background-color: #D3D3D3;" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
         <children>
            <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#handleVolver" style="-fx-background-color: transparent; -fx-cursor: hand;">
               <graphic>
                  <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../imagenes/imgRegresar.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <VBox alignment="CENTER_LEFT">
               <children>
                  <Label fx:id="lblNombreActividad" text="Nombre de la Actividad">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label text="Califica actividades">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>
   </top>
   <center>
      <StackPane style="-fx-background-color: #D6E0F0;" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="TOP_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="480.0" prefWidth="700.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #CCCCCC; -fx-border-radius: 15;">
               <padding>
                  <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
               </padding>
               <children>
                  <VBox spacing="10.0">
                     <children>
                        <Label fx:id="lblTituloPanel" text="Reporte parcial">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <Label text="Seleccionar practicante">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="cbPracticantes" prefHeight="35.0" prefWidth="350.0" promptText="Seleccione un practicante" style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 5;" />
                     </children>
                  </VBox>
                  <VBox fx:id="vboxDetallesReporte" managed="false" spacing="10.0" style="-fx-background-color: #F0F0F0; -fx-background-radius: 10; -fx-padding: 20;" visible="false" VBox.vgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblTipoEntrega" text="Reporte parcial">
                           <font>
                              <Font name="System Bold" size="15.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblFechaEntrega" text="Entregado xx/xx/xxxx" />
                        <Label fx:id="lblFechaLimite" text="Fecha límite xx/xx/xxxx" />
                        <Region VBox.vgrow="ALWAYS" />
                        <HBox alignment="CENTER_RIGHT" spacing="20.0">
                           <children>
                              <Button fx:id="btnDescargar" mnemonicParsing="false" onAction="#handleDescargar" prefHeight="40.0" prefWidth="130.0" style="-fx-background-color: white; -fx-border-color: #222222; -fx-border-radius: 5; -fx-cursor: hand;" text="Descargar">
                                 <font>
                                    <Font name="System Bold" size="13.0" />
                                 </font>
                              </Button>
                              <Button fx:id="btnCalificar" mnemonicParsing="false" onAction="#handleCalificar" prefHeight="40.0" prefWidth="130.0" style="-fx-background-color: white; -fx-border-color: #222222; -fx-border-radius: 5; -fx-cursor: hand;" text="Calificar">
                                 <font>
                                    <Font name="System Bold" size="13.0" />
                                 </font>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>
