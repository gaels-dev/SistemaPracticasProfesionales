<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.sistemapracticasprofesionales.controller.FXMLValidarDocumentosController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="90.0" spacing="15.0" style="-fx-background-color: #D3D3D3;" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
         <children>
            <Button fx:id="btnVolver" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand;" text="←">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Button>
            <VBox alignment="CENTER_LEFT">
               <children>
                  <Label text="Validar documentos">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label text="Elija un practicante y valide sus documentos">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>
   </top>
   <center>
      <HBox alignment="CENTER" spacing="30.0" style="-fx-background-color: #D6E0F0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
         </padding>
         <children>
            <VBox prefWidth="350.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #CCCCCC; -fx-border-radius: 15;" HBox.hgrow="NEVER">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label text="Lista de practicantes">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: white;" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="vboxPracticantes" spacing="10.0" />
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
            <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #CCCCCC; -fx-border-radius: 15;" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="25.0" left="25.0" right="25.0" top="20.0" />
               </padding>
               <children>
                  <Label text="Documentos del practicante seleccionado">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: white;" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="vboxDocumentos" spacing="12.0" />
                     </content>
                  </ScrollPane>
                  <HBox alignment="CENTER_RIGHT" spacing="30.0">
                     <children>
                        <Button fx:id="btnRechazarDocumento" mnemonicParsing="false" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #CC3333; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Rechazar documento" textAlignment="CENTER" wrapText="true" />
                        <Button fx:id="btnValidarDocumento" mnemonicParsing="false" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #222222; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Validar documento" textAlignment="CENTER" wrapText="true" />
                     </children>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>
