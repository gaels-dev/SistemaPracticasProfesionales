<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.sistemapracticasprofesionales.controlador.FXMLRegistrarPracticanteController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="90.0" spacing="15.0" style="-fx-background-color: #D3D3D3;" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
         <children>
            <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#handleVolver" style="-fx-background-color: transparent; -fx-cursor: hand;" text="←">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Button>
            <VBox alignment="CENTER_LEFT">
               <children>
                  <Label text="Registrar Practicante">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label text="Complete la información del nuevo practicante">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #D6E0F0;" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox prefWidth="450.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #CCCCCC; -fx-border-radius: 15;">
                     <padding>
                        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                     </padding>
                     <children>
                        <Label text="Información Personal">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        
                        <Label text="Matrícula" />
                        <TextField fx:id="tfMatricula" promptText="Ej. S24012345" />

                        <Label text="Nombre" />
                        <TextField fx:id="tfNombres" promptText="Ej. Juan Antonio" />

                        <HBox spacing="10.0">
                           <children>
                              <VBox HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Apellido Paterno" />
                                    <TextField fx:id="tfApellidoPaterno" promptText="Ej. Hernández" />
                                 </children>
                              </VBox>
                              <VBox HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Apellido Materno" />
                                    <TextField fx:id="tfApellidoMaterno" promptText="Ej. García" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <Label text="Correo Electrónico" />
                        <TextField fx:id="tfCorreo" promptText="Ej. juanito@gmail.com" />

                        <Label text="Sexo" />
                        <ComboBox fx:id="cmbSexo" maxWidth="Infinity" promptText="Seleccione sexo" />

                        <Label text="Fecha de nacimiento" />
                        <DatePicker fx:id="dpFechaNacimiento" maxWidth="Infinity" promptText="dd/mm/aaaa" />
                     </children>
                  </VBox>

                  <VBox prefHeight="300.0" prefWidth="400.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #CCCCCC; -fx-border-radius: 15;">
                     <padding>
                        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                     </padding>
                     <children>
                        <Label text="Información de Acceso">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        
                        <Label text="Nombre de usuario" />
                        <TextField fx:id="tfNombreUsuario" promptText="Ej. JAnt2026" />

                        <Label text="Contraseña del usuario" />
                        <PasswordField fx:id="pfContrasena" promptText="Ej. 12345" />
                     </children>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="30.0" />
               </VBox.margin>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="20.0">
               <children>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#handleCancelar" prefHeight="40.0" prefWidth="130.0" style="-fx-background-color: #555555; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Cancelar" />
                  <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#handleRegistrar" prefHeight="40.0" prefWidth="130.0" style="-fx-background-color: #222222; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Registrar" />
               </children>
               <VBox.margin>
                  <Insets bottom="30.0" right="60.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
