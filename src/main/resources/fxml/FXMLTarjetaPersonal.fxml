<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #F8F8F8; -fx-background-radius: 5; -fx-padding: 12;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.sistemapracticasprofesionales.controlador.FXMLTarjetaPersonalController">
   <children>
      <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
         <children>
            <Label fx:id="lblNombre" text="Nombre del Personal">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <HBox spacing="10.0">
         <children>
            <Button fx:id="btnEditar" mnemonicParsing="false" prefWidth="90.0" style="-fx-background-color: white; -fx-border-color: #222222; -fx-border-radius: 5; -fx-cursor: hand;" text="Editar" />
            <Button fx:id="btnInactivar" mnemonicParsing="false" prefWidth="90.0" style="-fx-background-color: DA2B0C; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Inactivar" />
            <Button fx:id="btnActivar" mnemonicParsing="false" onAction="#handleActivar" prefWidth="90.0" style="-fx-background-color: #1DD510; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Activar" />
         </children>
      </HBox>
   </children>
</HBox>
