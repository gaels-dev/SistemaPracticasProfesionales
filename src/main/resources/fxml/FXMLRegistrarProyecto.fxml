<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="550.0" spacing="20.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.sistemapracticasprofesionales.controlador.FXMLRegistrarProyectoController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      <Label text="Registrar Nuevo Proyecto">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </Label>
      <ScrollPane fitToWidth="true" prefHeight="458.0" prefWidth="486.0" style="-fx-background-color: transparent; -fx-background: white;" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="15.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Nombre del proyecto">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txfNombreProyecto" prefHeight="35.0" promptText="Ej. Sistema de gestión" style="-fx-background-color: #F0F0F0;" />
                        <Label fx:id="lblContadorNombre" alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" text="0/50" textFill="#666666" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Organización Vinculada">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="cmbOrganizacion" maxWidth="1.7976931348623157E308" prefHeight="35.0" promptText="Seleccione organización" style="-fx-background-color: #F0F0F0;" />
                     </children>
                  </VBox>
                  <Separator />
                  <Label text="Datos del Responsable Técnico">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Nombre">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txfNombresResponsable" prefHeight="35.0" promptText="Nombre" style="-fx-background-color: #F0F0F0;" />
                     </children>
                  </VBox>
                  <HBox spacing="10.0">
                     <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Apellido Paterno">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txfApellidoPaternoResponsable" prefHeight="35.0" promptText="Apellido Paterno" style="-fx-background-color: #F0F0F0;" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Apellido Materno">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txfApellidoMaternoResponsable" prefHeight="35.0" promptText="Apellido Materno" style="-fx-background-color: #F0F0F0;" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Correo electrónico">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txfCorreoResponsable" prefHeight="35.0" promptText="ejemplo@empresa.com" style="-fx-background-color: #F0F0F0;" />
                     </children>
                  </VBox>
                  <Separator />
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Descripción del proyecto (Máx. 200 caracteres)">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextArea fx:id="txaDescripcion" prefHeight="100.0" promptText="Describa las actividades y objetivos" style="-fx-control-inner-background: #F0F0F0;" wrapText="true" />
                        <Label fx:id="lblContadorCaracteres" alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" text="0/200" textFill="#666666" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Vacantes disponibles">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txfVacantes" prefHeight="35.0" promptText="Ej. 3" style="-fx-background-color: #F0F0F0;" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#handleGuardarProyecto" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #222222; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Guardar proyecto" />
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#handleCancelar" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: white; -fx-border-color: #222222; -fx-border-radius: 5; -fx-cursor: hand;" text="Cancelar" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
